# Configuración del backend. Copia a backend/.env. Nunca subas .env al repo.

# development (local, con /api/docs) | production (sin /api/docs). En Docker la fija docker-compose.yml.
APP_ENV=development
LOG_LEVEL=INFO

# Ollama (puerto 11434). Todo corre en la misma máquina:
#   backend de desarrollo (uvicorn)             -> http://127.0.0.1:11434
#   backend en Docker, Ollama instalado en host -> http://host.docker.internal:11434
#   backend en Docker, Ollama del Compose       -> http://ollama:11434 (perfil "ollama")
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=
# Segundos máximos sin recibir nada del modelo durante el chat (cargar un modelo en GPU tarda)
OLLAMA_CHAT_READ_TIMEOUT_SECONDS=300
# Razonamiento de los modelos que lo tienen (qwen3.5, deepseek-r1...). false = respuesta directa.
# Con true tardan mucho más en empezar y pueden agotar el límite sin responder.
# Con true, los modelos sin razonamiento (llama3...) dan error.
OLLAMA_THINK=false
# Contexto (tokens) de los modelos locales si la personalidad no fija num_ctx. Más contexto =
# más memoria de la conversación, pero más VRAM (8192 cabe con un 9B en 8 GB; 16384 con 12 GB).
OLLAMA_NUM_CTX=8192

# Proveedores compatibles con OpenAI (opcional, ADR-019), además de Ollama. Sin PROVIDERS, solo Ollama.
# Nombres en minúsculas, solo letras y números (van en el nombre de las variables). En el
# selector, sus modelos salen como <nombre>/<modelo>.
# Lo que escribas a un proveedor remoto sale de tu red: nada de datos reales ni de clientes.
PROVIDERS=
# Por cada proveedor de PROVIDERS:
#   PROVIDER_<NOMBRE>_BASE_URL        obligatoria
#   PROVIDER_<NOMBRE>_API_KEY         opcional (sin ella no se envía cabecera Authorization)
#   PROVIDER_<NOMBRE>_MODELS          lista permitida, separada por comas; vacía = todos los de chat
#   PROVIDER_<NOMBRE>_VISION_MODELS   modelos que aceptan imágenes (la API no lo dice)
#   PROVIDER_<NOMBRE>_CONTEXT_TOKENS  presupuesto para ajustar el historial (def. 6000)
#   PROVIDER_<NOMBRE>_LOCAL           true si corre en esta máquina (LM Studio, llama.cpp): sin avisos de nube
#
# Ejemplo: Groq (plan gratuito: ~8000 tokens/min, así que no subas mucho CONTEXT_TOKENS).
# Clave en console.groq.com.
# PROVIDERS=groq,lmstudio
# PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_GROQ_API_KEY=
# PROVIDER_GROQ_MODELS=
# PROVIDER_GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
# PROVIDER_GROQ_CONTEXT_TOKENS=6000
#
# Ejemplo: LM Studio en esta máquina (servidor en el puerto 1234, escuchando solo en 127.0.0.1:
# "Serve on Local Network" desactivado). CONTEXT_TOKENS debe coincidir con la ventana con la que
# cargas el modelo en LM Studio.
#   backend de desarrollo (uvicorn): http://127.0.0.1:1234/v1
#   backend en Docker:               http://host.docker.internal:1234/v1
# PROVIDER_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# PROVIDER_LMSTUDIO_LOCAL=true
# PROVIDER_LMSTUDIO_CONTEXT_TOKENS=16384

# OBSOLETO (ADR-019): el hueco único de nube. Solo se usa si PROVIDERS está vacío y hay
# CLOUD_API_KEY; se carga como un proveedor "groq" con 6000 tokens de contexto y avisa en el log.
# CLOUD_API_KEY=

# Base de datos. Ruta relativa al directorio de trabajo: en Docker es /app/data (volumen ./data).
# En local, arrancando desde backend/, usa sqlite:///../data/txatbot.db para compartir la de la raíz.
DATABASE_URL=sqlite:///./data/txatbot.db

# Login de un solo usuario. Genera los valores con:
#   uv run python -m app.cli hash-password    (pide la contraseña, mínimo 12 caracteres)
#   uv run python -m app.cli session-secret
# Sin estos tres valores el login responde 503 y la API protegida queda cerrada.
AUTH_USERNAME=
# Hash argon2 entre comillas simples (contiene "$"). Nunca la contraseña en claro.
AUTH_PASSWORD_HASH=
# Mínimo 32 caracteres. Cambiarlo, hacer logout o reiniciar el backend cierra todas las sesiones.
SESSION_SECRET=
# Duración de la sesión en horas
SESSION_TTL_HOURS=72
# true solo si la app se sirve por HTTPS (con HTTP el navegador descarta la cookie)
COOKIE_SECURE=false
# Bloqueo tras N intentos fallidos en la ventana (segundos), para todo el servidor
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Subidas de ficheros (tamaño máximo por fichero y carpeta donde se guardan)
UPLOAD_MAX_MB=20
UPLOAD_DIR=./data/uploads
