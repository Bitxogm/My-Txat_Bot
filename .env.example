# Variables de Docker Compose. Copia a .env y ajusta. Nunca subas .env al repo.

COMPOSE_PROJECT_NAME=txatbot

# IP en la que se publica el frontend (la app). 127.0.0.1 = solo esta máquina.
# Para usarla desde la red de casa, pon la IP de LAN de la máquina (p. ej. la de `ip -br addr`).
# Nunca 0.0.0.0 sin decidirlo, nunca puertos abiertos en el router ni túneles públicos.
# El backend y Ollama se publican siempre solo en 127.0.0.1 (Ollama no tiene autenticación).
# Tailscale es opcional: si lo adoptas, puedes poner aquí su IP en vez de la de LAN.
BIND_ADDR=127.0.0.1

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Solo si levantas Ollama con este Compose (perfil "ollama"); siempre en 127.0.0.1
OLLAMA_PORT=11434

# UID/GID del usuario del contenedor backend. Deben coincidir con el dueño de ./data
# en el host (id -u / id -g) para que SQLite pueda escribir.
APP_UID=1000
APP_GID=1000
