# Variables de Docker Compose. Copia a .env y ajusta. Nunca subas .env al repo.

COMPOSE_PROJECT_NAME=txatbot

# IP en la que se publican los puertos. 127.0.0.1 = solo esta máquina.
# Para usarlo desde la red de casa o Tailscale, pon la IP LAN o Tailscale de la máquina.
# Nunca abras puertos en el router.
# Ojo: con una IP LAN, Ollama (perfil "ollama") queda abierto a toda la red sin auth. Para Ollama usa la IP de Tailscale.
BIND_ADDR=127.0.0.1

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Solo si levantas Ollama en esta misma máquina (perfil "ollama")
OLLAMA_PORT=11434

# UID/GID del usuario del contenedor backend. Deben coincidir con el dueño de ./data
# en el host (id -u / id -g) para que SQLite pueda escribir.
APP_UID=1000
APP_GID=1000
